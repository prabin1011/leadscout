GOOGLE_MAPS_API_KEY=replace-with-a-restricted-server-key
META_ACCESS_TOKEN=replace-with-a-meta-access-token
ANTHROPIC_API_KEY=replace-with-an-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
FABLE_MODEL=claude-fable-5
CAMPAIGN_MODEL=claude-sonnet-4-6

# Optional safety controls
PLACES_RATE_LIMIT=10
PLACES_DAILY_LIMIT=250
PLACES_CACHE_MS=900000

# Recommended for persistent Vercel rate limits and caching
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
